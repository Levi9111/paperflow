{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PaperFlow",
  "version": "0.2.0",
  "identifier": "io.github.paperflow.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PaperFlow",
        "width": 1180,
        "height": 780,
        "minWidth": 940,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Privacy-First On-Device PDF Studio",
    "longDescription": "High-performance, 100% offline PDF manager for Fedora Linux and Android with zero cloud dependencies.",
    "copyright": "2026 PaperFlow",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
